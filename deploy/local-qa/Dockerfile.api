# syntax=docker/dockerfile:1
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=secret,id=proxy_ca,required=true SSL_CERT_FILE=/run/secrets/proxy_ca go mod download
COPY . .
RUN CGO_ENABLED=0 go build -buildvcs=false -trimpath -o /out/dataflow ./cmd/dataflow

FROM alpine:3.21
RUN --mount=type=secret,id=proxy_ca,target=/etc/ssl/cert.pem,required=true \
    apk add --no-cache ca-certificates && adduser -D -u 10001 dataflow
COPY --from=build /out/dataflow /usr/local/bin/dataflow
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/dataflow"]
