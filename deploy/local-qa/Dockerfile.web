FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# No root-owned listener or CAP_SETUID requirement in isolated browser QA.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/local-qa/nginx.core-qa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/ /usr/share/nginx/html/
EXPOSE 8080
