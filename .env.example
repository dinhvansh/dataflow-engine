# NEVER commit real credentials
DATAFLOW_PG_PASSWORD=replace_me
DATAFLOW_POSTGRES_DSN=postgres://dataflow:replace_me@localhost:5433/dataflow?sslmode=disable
DATAFLOW_SQLSERVER_DSN=sqlserver://readonly_user:replace_me@localhost:1433?database=ERPDBTEST
DATAFLOW_CH_URL=http://localhost:8124
DATAFLOW_CH_USER=default
DATAFLOW_CH_PASSWORD=
DATAFLOW_API_TOKEN=replace_with_long_random_token
DATAFLOW_ALLOW_TEST_LOAD=false
PORT=8080

# All bootstrap writes restricted to this disposable ClickHouse database
DATAFLOW_TEST_TARGET_DATABASE=scratch

# Managed incremental is OFF unless both flags below are enabled
DATAFLOW_ENABLE_MANAGED_TEST=false
# Independent scheduler opt-in; only works with managed test enabled
DATAFLOW_ENABLE_MANAGED_SCHEDULER=false

# Read-only source snapshot comparison; writes key snapshots to scratch only
DATAFLOW_ENABLE_RECONCILIATION_TEST=false

# SQL job / DAG execution is disabled by default.
# Use a distinct ClickHouse account with SELECT-only grants for scratch objects.
DATAFLOW_ENABLE_SQL_JOBS_TEST=false
DATAFLOW_CH_READONLY_USER=
DATAFLOW_CH_READONLY_PASSWORD=

# Transform Studio v0.8 uses SQL Jobs' read-only ClickHouse test account/flags.
# Apply migration 010 in existing PostgreSQL before saving models.
# NO dbt worker, DML or mart materialization enabled.

# dbt View worker v0.9: isolated TEST scratch only; defaults disabled.
DATAFLOW_ENABLE_DBT_TEST=false
DATAFLOW_DBT_CH_HOST=
DATAFLOW_DBT_CH_PORT=8123
DATAFLOW_DBT_CH_USER=
DATAFLOW_DBT_CH_PASSWORD=
DATAFLOW_DBT_CH_SECURE=false
# Apply migrations/postgres/011_dbt_runs.sql to existing TEST database before enabling.
