# NEVER commit real credentials
DATAFLOW_PG_PASSWORD=replace_me
DATAFLOW_POSTGRES_DSN=postgres://dataflow:replace_me@localhost:5433/dataflow?sslmode=disable
DATAFLOW_SQLSERVER_DSN=sqlserver://readonly_user:replace_me@localhost:1433?database=ERPDBTEST
DATAFLOW_CH_URL=http://localhost:8124
DATAFLOW_CH_USER=default
DATAFLOW_CH_PASSWORD=
DATAFLOW_API_TOKEN=replace_with_long_random_token
DATAFLOW_ALLOW_TEST_LOAD=false
PORT=8080

# All bootstrap writes restricted to this disposable ClickHouse database
DATAFLOW_TEST_TARGET_DATABASE=scratch

# Managed incremental is OFF unless both flags below are enabled
DATAFLOW_ENABLE_MANAGED_TEST=false
# Independent scheduler opt-in; only works with managed test enabled
DATAFLOW_ENABLE_MANAGED_SCHEDULER=false

# Read-only source snapshot comparison; writes key snapshots to scratch only
DATAFLOW_ENABLE_RECONCILIATION_TEST=false

# SQL job / DAG execution is disabled by default.
# Use a distinct ClickHouse account with SELECT-only grants for scratch objects.
DATAFLOW_ENABLE_SQL_JOBS_TEST=false
DATAFLOW_CH_READONLY_USER=
DATAFLOW_CH_READONLY_PASSWORD=

# Transform Studio v0.8 uses SQL Jobs' read-only ClickHouse test account/flags.
# Apply migration 010 in existing PostgreSQL before saving models.
# NO dbt worker, DML or mart materialization enabled.

# dbt View worker v0.9: isolated TEST scratch only; defaults disabled.
DATAFLOW_ENABLE_DBT_TEST=false
DATAFLOW_DBT_CH_HOST=
DATAFLOW_DBT_CH_PORT=8123
DATAFLOW_DBT_CH_USER=
DATAFLOW_DBT_CH_PASSWORD=
DATAFLOW_DBT_CH_SECURE=false
# Apply migrations/postgres/011_dbt_runs.sql to existing TEST database before enabling.

# v1.1 Table staging/publish, separately gated, disposable TEST scratch only.
DATAFLOW_ENABLE_SAFE_TABLE_TEST=false

# v1.2 Auto Build Dependencies, isolated scratch TEST only. Default disabled.
DATAFLOW_ENABLE_AUTO_BUILD_TEST=false

# v1.3 isolated scratch copy-on-write incremental, disabled by default.
DATAFLOW_ENABLE_INCREMENTAL_TEST=false

# v1.4 optional CDC historical integrity guard (migration 015). TEST-only.
# This scans all past events, detects but does not repair late arrivals.
DATAFLOW_ENABLE_INCREMENTAL_HISTORY_GUARD_TEST=false

# V3.2B-5A: isolated, TLS-only OIDC scoped VIEW endpoint; OFF by default.
# Requires migration 018 on identity-verified disposable control PostgreSQL.
# The current plaintext Go listener will reject this route (TLS required).
# NEVER put signing private keys, Vault tokens or DB passwords in Git.
DATAFLOW_ENABLE_SECURE_CONNECTION_VIEW_TEST=false
DATAFLOW_SECURE_CONNECTIONS_ISOLATED_LAB=false
DATAFLOW_SECURE_OIDC_ISSUER=
DATAFLOW_SECURE_OIDC_AUDIENCE=
DATAFLOW_SECURE_OIDC_KID=
# Trusted server-local RS256 PUBLIC key PEM path only (not a private key).
DATAFLOW_SECURE_OIDC_RS256_PUBLIC_KEY_FILE=

# V3.2B-5D: HTTPS 1.3 DIRECT listener in isolated TEST ONLY (default OFF).
# Provide operator-generated certificate and chmod 0600 private key outside Git.
# When secure OIDC connection VIEW is enabled, DIRECT TLS must also be enabled.
# Forwarded X-Forwarded-Proto headers are NOT trusted as TLS evidence.
DATAFLOW_ENABLE_DIRECT_TLS_TEST=false
DATAFLOW_DIRECT_TLS_CERT_FILE=
DATAFLOW_DIRECT_TLS_KEY_FILE=
